# The backend URL ships in the bundle. That is the architecture, not a leak
# (rules/vue-spa/stack-standards.md). Never put a secret behind a VITE_ prefix —
# the prefix is what puts it in the browser.
VITE_API_BASE_URL=http://localhost:8080/api

# MSW runs in `npm run dev` by default. Set to '0' to talk to the real backend.
VITE_ENABLE_MSW=1
